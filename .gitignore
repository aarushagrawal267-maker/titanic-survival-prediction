# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
env/
.env/
.ipynb_checkpoints/
# Trained models ARE committed (so deployments start instantly); only runtime files are ignored
models/.retrain.lock
# Generated outputs
data/processed/*
!data/processed/.gitkeep
outputs/reports/prediction_log.csv
# Secrets (never commit credentials; .env.example is the only allowed template)
kaggle.json
.kaggle/
.streamlit/secrets.toml
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
# Kaggle competition CSVs: downloaded at run time (Kaggle's rules do not allow redistributing them)
data/raw/*.csv
# Data dumps / local databases
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz
# OS / editors
.DS_Store
.vscode/
.idea/
node_modules/

# Docker
.dockerignore.bak
